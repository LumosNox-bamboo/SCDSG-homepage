{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scdsg-med-homepage",
  "pages_build_output_dir": ".",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "REGISTRATIONS_DB",
      "database_name": "scdsg-association-production",
      "database_id": "cbfd31ee-0795-4af2-b29c-45810cdf4bc2",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SUBMISSION_FILES",
      "bucket_name": "scdsg-private-submissions",
      "jurisdiction": "eu"
    }
  ]
}
